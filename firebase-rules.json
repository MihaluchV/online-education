{
  "rules": {
    "teachers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'"
      }
    },
    "logins": {
      "$l": {
        ".read": true,
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (!data.exists() || data.child('o').val() === auth.uid)"
      }
    },
    "classes": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'"
      }
    },
    "tasks": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'"
      }
    },
    "journal": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider === 'password'"
      }
    },
    "codes": {
      "$c": {
        ".read": true,
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && (!data.exists() || data.child('o').val() === auth.uid)"
      }
    },
    "owners": {
      "$t": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password' && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))"
      }
    },
    "works": {
      "$t": {
        ".read": "auth != null && root.child('owners').child($t).val() === auth.uid",
        ".write": "auth != null && root.child('owners').child($t).val() === auth.uid",
        "$s": {
          ".read": "auth != null && (!data.exists() || data.child('u').val() === auth.uid || data.child('on').val() !== true)",
          "u": {
            ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid || data.parent().child('on').val() !== true)"
          },
          "n": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "fn": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "ln": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "cls": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "cn": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "upd": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "on": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "help": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "sRead": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "ini": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "sub": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "auto": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "files": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid"
          },
          "st": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid && data.val() !== 'checked'",
            ".validate": "newData.val() === 'work' || newData.val() === 'submitted' || root.child('owners').child($t).val() === auth.uid"
          },
          "chat": {
            "$m": {
              ".write": "auth != null && !data.exists() && newData.child('f').val() === 's' && data.parent().parent().child('u').val() === auth.uid",
              ".validate": "newData.hasChildren(['f','m','at'])",
              "m": {
                ".validate": "newData.isString() && newData.val().length <= 1000"
              }
            }
          },
          "aw": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid && (!data.exists() || newData.val() >= data.val())",
            ".validate": "newData.isNumber()"
          },
          "am": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid && (!data.exists() || newData.val() >= data.val())",
            ".validate": "newData.isNumber()"
          },
          "lk": {
            ".write": "auth != null && data.parent().child('u').val() === auth.uid && newData.val() === true"
          }
        }
      }
    }
  }
}
